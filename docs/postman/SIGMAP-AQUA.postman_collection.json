{
  "info": {
    "_postman_id": "6ee39583-b1e0-4586-82d9-ea081e1fc594",
    "name": "SIGMAP-AQUA API",
    "description": "Pruebas de la API del ESP32 de SIGMAP-AQUA: /api/v1/ (token de dispositivo: `Authorization: Device <token>`).\n\nTodas las respuestas usan el formato `{success, data, message}`. Ejecutar en orden con el Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. ESP32 (token de dispositivo)",
      "item": [
        {
          "name": "D1 Handshake sin token → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/dispositivos/handshake/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "dispositivos",
                "handshake"
              ]
            },
            "description": "Sin cabecera Authorization: el decorador dispositivo_requerido corta antes de tocar la BD.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "const j = pm.response.json();",
                  "pm.test(\"Formato {success, data, message}\", () => {",
                  "  pm.expect(j).to.have.all.keys(\"success\", \"data\", \"message\");",
                  "});",
                  "pm.test(\"success = false\", () => pm.expect(j.success).to.eql(false));"
                ]
              }
            }
          ]
        },
