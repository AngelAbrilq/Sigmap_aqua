              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "lecturas"
              ]
            },
            "description": "Valores fuera de rango: deben abrir alertas en el motor de alertas.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lecturas\": {{lecturas_crit}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s = JSON.parse(pm.collectionVariables.get(\"sensores_esperados\") || \"[]\");",
                  "const v = {ph: 9.6, oxigeno: 2.0, \"oxígeno\": 2.0, temperatura: 38.0, turbidez: 900.0};",
                  "const pick = p => { p = (p||\"\").toLowerCase(); for (const k in v) if (p.includes(k)) return v[k]; return 1; };",
                  "pm.variables.set(\"lecturas_crit\", JSON.stringify(s.map(x => ({codigo_hardware: x.codigo_hardware, valor: pick(x.parametro)}))));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Formato {success, data, message}\", () => {",
                  "  pm.expect(j).to.have.all.keys(\"success\", \"data\", \"message\");",
                  "});",
                  "pm.test(\"success = true\", () => pm.expect(j.success).to.eql(true));",
                  "pm.test(\"Hay lecturas críticas\", () => pm.expect(j.data.criticas).to.be.above(0));"
                ]
              }
            }
          ]
