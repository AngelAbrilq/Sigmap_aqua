        {
          "name": "D4 Handshake OK → 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Device {{device_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/dispositivos/handshake/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "dispositivos",
                "handshake"
              ]
            },
            "description": "Verifica enlace, actualiza ultima_conexion y devuelve los sensores esperados.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firmware\": \"postman-1.0\",\n  \"mac\": \"AA:BB:CC:DD:EE:FF\",\n  \"rssi\": -55\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"Formato {success, data, message}\", () => {",
                  "  pm.expect(j).to.have.all.keys(\"success\", \"data\", \"message\");",
                  "});",
                  "pm.test(\"success = true\", () => pm.expect(j.success).to.eql(true));",
                  "pm.test(\"Devuelve hora_servidor\", () => pm.expect(j.data.hora_servidor).to.be.a(\"string\"));",
                  "const s = j.data.sensores_esperados || [];",
                  "pm.collectionVariables.set(\"sensores_esperados\", JSON.stringify(s));",
                  "if (s.length === 0) console.warn(\"La piscina del dispositivo no tiene sensores activos: la ingesta D9/D10 fallará con 400.\");"
                ]
              }
            }
          ]
        },
