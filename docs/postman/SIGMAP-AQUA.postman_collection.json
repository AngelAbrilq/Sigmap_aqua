        {
          "name": "D9 Ingesta normal → 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Device {{device_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/lecturas/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "lecturas"
              ]
            },
            "description": "Arma el lote con los sensores que devolvió D4. Requiere que la piscina del dispositivo tenga sensores activos.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firmware\": \"postman-1.0\",\n  \"mac\": \"AA:BB:CC:DD:EE:FF\",\n  \"lecturas\": {{lecturas_ok}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s = JSON.parse(pm.collectionVariables.get(\"sensores_esperados\") || \"[]\");",
                  "const v = {ph: 7.2, oxigeno: 6.5, \"oxígeno\": 6.5, temperatura: 26.0, turbidez: 15.0};",
                  "const pick = p => { p = (p||\"\").toLowerCase(); for (const k in v) if (p.includes(k)) return v[k]; return 1; };",
                  "pm.variables.set(\"lecturas_ok\", JSON.stringify(s.map(x => ({codigo_hardware: x.codigo_hardware, valor: pick(x.parametro)}))));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Formato {success, data, message}\", () => {",
                  "  pm.expect(j).to.have.all.keys(\"success\", \"data\", \"message\");",
                  "});",
                  "pm.test(\"success = true\", () => pm.expect(j.success).to.eql(true));",
                  "pm.test(\"Registradas > 0\", () => pm.expect(j.data.registradas).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "D10 Ingesta crítica → 201 + alertas",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
