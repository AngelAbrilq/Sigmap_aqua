# Plantilla de variables de entorno. Copiar a .env y completar.
# UTF-8 SIN BOM.

# Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=REEMPLAZAR-genera-la-tuya-y-no-la-subas

DEBUG=True
ALLOWED_HOSTS=

DB_NAME=sigmap_agua
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Seguridad (produccion). Deja SECURE_SSL en False mientras los ESP32 usen http.
SECURE_SSL=False
CSRF_TRUSTED_ORIGINS=

# Correo saliente (recuperacion de contrasena). Si EMAIL_HOST queda vacio,
# los correos se muestran en la consola de runserver.
# Con Gmail: EMAIL_HOST=smtp.gmail.com y una "contrasena de aplicacion".
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Analisis con IA. DeepSeek es el principal; Gemini es opcional (respaldo).
IA_PROVEEDOR=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
GEMINI_API_KEY=

# Acceso de demostración por QR (sustentación). Ver apps/demo.
DEMO_QR_ACTIVO=False
DEMO_QR_HORAS=24
DEMO_QR_VERSION=1
DEMO_QR_SESION_MINUTOS=120
DEMO_QR_URL_BASE=https://g8lnb4b3-8000.use.devtunnels.ms
